{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DU8866-nice/shopify-launch-check-skill/skills/shopify-launch-check/report-schema.json",
  "title": "Shopify launch check report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store",
    "checked_at",
    "region",
    "admin_access",
    "pages_checked",
    "summary",
    "findings",
    "not_checked",
    "confirm_yourself"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" }
      }
    },
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "region": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "admin_access": { "type": "boolean" },
    "pages_checked": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^https?://" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_to_launch", "headline"],
      "properties": {
        "ready_to_launch": { "type": "boolean" },
        "headline": { "type": "string", "minLength": 1 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "reason"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "confirm_yourself": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "why"],
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "title", "locations", "problem", "impact", "fix", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^SLC-\\d{3}$" },
        "severity": { "enum": ["critical", "important", "nice_to_have"] },
        "category": {
          "enum": [
            "reachability",
            "home",
            "collections",
            "product",
            "checkout",
            "policies",
            "notifications",
            "seo",
            "performance",
            "accessibility",
            "regional"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "const": "admin" },
              { "type": "string", "pattern": "^https?://" }
            ]
          }
        },
        "problem": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "fix": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "detail"],
          "properties": {
            "type": { "enum": ["observed", "inferred"] },
            "detail": { "type": "string", "minLength": 1 }
          }
        },
        "rule": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "category": { "const": "regional" } } },
      "then": { "required": ["rule"] }
    }
  }
}
